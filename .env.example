# Kopieer dit bestand naar .env en pas de waarden aan.
# Het .env-bestand wordt niet in git opgenomen.

# Geheime sleutel voor sessies/cookies. Genereer er een met:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=verander-dit-in-een-lange-willekeurige-sleutel

# Standaard wordt SQLite gebruikt (instance/bib.db).
# Voor PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://gebruiker:wachtwoord@localhost/bibdb

# 1 = debug/reloader aan, 0 = uit (aanbevolen bij productie)
FLASK_DEBUG=1

# Server
HOST=127.0.0.1
PORT=5000

# Maximale uploadgrootte in bytes (standaard 5 MB)
# MAX_CONTENT_LENGTH=5242880

# Optioneel: Google Books API-key voor snellere en ruimere metadata-lookup.
# Zonder key werkt de scan ook, maar met een lagere quota.
# GOOGLE_BOOKS_API_KEY=

# Time-out per metadata-aanroep in seconden
# ISBN_LOOKUP_TIMEOUT=8
